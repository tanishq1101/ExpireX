// Prisma is used for SCHEMA/MIGRATIONS ONLY. No runtime queries go through Prisma
// (that would bypass RLS via the direct connection). All runtime reads/writes use the
// Supabase client so `auth.uid()` RLS policies apply.
//
// RLS policies, the auth.users -> public.users trigger, storage bucket/policies, and the
// pg_cron job are NOT expressible in Prisma. They live in supabase/migrations/*.sql and
// MUST be kept in sync with this schema by hand. After `prisma migrate`, apply the SQL
// files below in the Supabase SQL editor (or via `supabase db push`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  food
  medicine
  cosmetics
  documents
  warranty
  subscription
  other
}

enum ReminderType {
  d30
  d15
  d7
  d3
  d1
}

model User {
  id                    String   @id // Clerk user id (text, e.g. user_2ab...)
  email                 String
  emailRemindersEnabled Boolean  @default(true) @map("email_reminders_enabled")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items            Item[]
  notificationLogs NotificationLog[]

  @@map("users")
}

model Item {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") // Clerk user id (text)
  name            String
  category        Category
  expiryDate      DateTime  @map("expiry_date") @db.Date
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  quantity        Decimal?  @db.Decimal
  unit            String?
  notes           String?
  barcode         String? // EAN/UPC/QR scanned at entry (identifies the product, not the date)
  location        String? // storage location e.g. Fridge, Pantry
  openedDate      DateTime? @map("opened_date") @db.Date
  openWithinDays  Int?      @map("open_within_days")
  // DB-generated (least(expiry_date, opened_date + open_within_days)); managed via SQL, not Prisma.
  effectiveExpiry DateTime? @map("effective_expiry") @db.Date
  imageUrl        String?   @map("image_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]
  shoppingList     ShoppingList[]

  @@index([userId, expiryDate])
  @@index([userId, category])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, barcode])
  @@index([userId, effectiveExpiry])
  @@index([expiryDate])
  @@map("items")
}

model ShoppingList {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") // Clerk user id (text)
  name      String
  quantity  Decimal? @db.Decimal
  unit      String?
  note      String?
  source    String   @default("manual") // 'manual' | 'auto'
  itemId    String?  @map("item_id") @db.Uuid
  checked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, checked, createdAt(sort: Desc)])
  @@map("shopping_list")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationLog {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId       String       @map("item_id") @db.Uuid
  userId       String       @map("user_id") // Clerk user id (text)
  reminderType ReminderType @map("reminder_type")
  sentAt       DateTime     @default(now()) @map("sent_at") @db.Timestamptz(6)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, reminderType]) // hard dedup guarantee for reminders
  @@map("notification_log")
}

model Barcodecatalog {
  barcode        String    @id
  name           String
  brand          String?
  size           String?
  category       Category?
  imageUrl       String?   @map("image_url")
  source         String    @default("api")
  confirmedCount Int       @default(0) @map("confirmed_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("barcode_catalog")
}
