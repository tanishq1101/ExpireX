# ---------- Supabase (client-safe) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# ---------- Supabase (server only) ----------
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # NEVER imported into a client component

# ---------- Prisma (migrations only) ----------
# Pooled connection for app would be here, but we only use Prisma for migrations.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---------- Gemini (server only) — reads the label photo (OCR) + extracts fields ----------
GEMINI_API_KEY=YOUR-GEMINI-KEY

# ---------- Edge Function secrets (set via `supabase secrets set`, not in Vercel) ----------
# RESEND_API_KEY=re_...
# RESEND_FROM="Expire X <reminders@yourdomain.com>"
# CRON_SECRET=long-random-string   # shared between pg_cron call and the Edge Function

# ---------- Clerk ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Subscribe the signed /api/webhooks/clerk endpoint to user.created, user.updated, user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# ---------- Optional welcome email (Next.js server) ----------
# RESEND_API_KEY=re_...
# RESEND_FROM="Expire X <reminders@yourdomain.com>"

# ---------- Web push (Next.js; CRON_SECRET is required here too) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-support@example.com
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
